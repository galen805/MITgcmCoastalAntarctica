# This set-up makes is supposed to imitate salt. That is, PTRACER(:,:,:,1)
# should look exactly like S(:,:,:).
 &PTRACERS_PARM01
 PTRACERS_numInUse=4,

# adjust if restarting from checkpoint
 PTRACERS_Iter0 = 0,


PTRACERS_dumpFreq = 864000.0,
# PTRACERS_addSrelax2EmP=.TRUE.,
#-- for each tracer
# PTRACERS_advScheme(1)=2,
 PTRACERS_diffKh(1)=0.0,
 PTRACERS_diffKr(1)=5.E-7,
 PTRACERS_EvPrRn(1)=0.,
#PTRACERS_useDWNSLP(1)=.FALSE.,
#PTRACERS_stayPositive(1)=.FALSE.,
 PTRACERS_initialFile(1)='ptracers_file.bin',
#EH3 added for MNC
 PTRACERS_names(1)='salt_mimic',

# PTRACERS_advScheme(2)=2,
 PTRACERS_diffKh(2)=0.0,
 PTRACERS_diffKr(2)=5.E-7,
 PTRACERS_EvPrRn(2)=0.,
