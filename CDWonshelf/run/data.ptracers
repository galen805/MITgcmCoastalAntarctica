#EH3 added for MNC
 PTRACERS_names(2)='seaice_melt_ptr',

# PTRACERS_advScheme(3)=2,
 PTRACERS_diffKh(3)=0.0,
 PTRACERS_diffKr(3)=5.E-7,
 PTRACERS_EvPrRn(3)=0.,
#PTRACERS_useDWNSLP(3)=.FALSE.,
#PTRACERS_stayPositive(3)=.FALSE.,
 PTRACERS_initialFile(3)='ptracers_file.bin',
#EH3 added for MNC
 PTRACERS_names(3)='shelfice_melt_ptr',

# PTRACERS_advScheme(4)=2,
 PTRACERS_diffKh(4)=0.0,
