# ====================
# | Model parameters |
# ====================
#
# Continuous equation parameters
 &PARM01
# reference temp and salinity
 tRefFile = 'T_init_file.bin',
 sRefFile = 'salt_init_file.bin',
# viscosity and diffusivity constants
 viscAr=1.E-7,
# smag depends on velocity
 viscC2smag=0.5,
# biharmonic
 viscA4Grid=0.05,
 viscA4GridMax=0.5,
 diffK4T=0.0,
 diffKr4T=5.E-7,
 diffK4S=0.0,
 diffKr4S=5.E-7,

# bottom drag
 no_slip_sides=.FALSE.,
 no_slip_bottom=.FALSE.,
 bottomDragQuadratic=2.5E-3,

# advection and diffusion schemes
 nonHydrostatic=.FALSE.,
 implicitDiffusion  = .TRUE.,
 implicitViscosity  = .TRUE.,
 saltAdvScheme=33,
 saltVertAdvScheme =33,
 tempAdvScheme=33,
 tempVertAdvScheme=33,

# free surface
 rigidLid=.FALSE.,
 implicitFreeSurface=.TRUE.,

# other stuff
 eosType='JMD95Z', 
 HeatCapacity_cp = 3974.0,
 rhoConst=1030.,
 rhoNil=1030.,
 gravity=9.81,
 convertFW2Salt = 33.4,
 exactConserv=.TRUE.,
 hFacMin=0.2,
 readBinaryPrec=64,
 staggerTimeStep=.TRUE.,
# useCDScheme = .TRUE.,
 &

# Elliptic solver parameters
 &PARM02
 cg2dMaxIters=1000,
 cg2dTargetResidual=1.E-13,
 cg3dMaxIters=400,
 cg3dTargetResidual=1.E-13,
 &


# Time stepping parameters
 &PARM03

# aWinter first 200 days
 nIter0=0,
 nTimeSteps=576000,

# bWinter next 200 days
# nIter0=576000,
# nTimeSteps=576000,


 deltaT=30.0,
 abEps=0.1,
 cAdjFreq = 0,
# tauCD = 400000.,
 pChkptFreq=4320000.0,
# pChkptFreq=2160000,
# chkptFreq=432000.0,
 dumpFreq=43200.0,
 taveFreq=0.0,
 monitorFreq=36000.,
 monitorSelect=2,
tracForcingOutAB = 1,
 &

# Gridding parameters
 &PARM04
 usingSphericalPolarGrid=.TRUE.,
 ygOrigin = -74.0,
# delX=192*0.078125,
# delY=384*0.02609375,
 delXfile='dxfile.bin',
 delYfile='dyfile.bin',
 delRfile='dzfile.bin',
 &

# Input datasets
 &PARM05
 bathyFile='bathy.box',
 hydrogThetaFile='rbcs_T_file.bin',
 hydrogSaltFile='rbcs_S_file.bin',
# uVelInitFile='u_3d_end_state.bin',
# vVelInitFile='rbcs_V_file.bin',
 &
