# Diagnostic Package Choices
#--------------------
#  dumpAtLast (logical): always write output at the end of simulation (default=F)
#  diag_mnc   (logical): write to NetCDF files (default=useMNC)
#--for each output-stream:
#  fileName(n) : prefix of the output file name (max 80c long) for outp.stream n
#  frequency(n):< 0 : write snap-shot output every |frequency| seconds
#               > 0 : write time-average output every frequency seconds
#  timePhase(n)     : write at time = timePhase + multiple of |frequency|
#    averagingFreq  : frequency (in s) for periodic averaging interval
#    averagingPhase : phase     (in s) for periodic averaging interval
#    repeatCycle    : number of averaging intervals in 1 cycle
#  levels(:,n) : list of levels to write to file (Notes: declared as REAL)
#                when this entry is missing, select all common levels of this list
#  fields(:,n) : list of selected diagnostics fields (8.c) in outp.stream n
#                (see "available_diagnostics.log" file for the full list of diags)
#  missing_value(n) : missing value for real-type fields in output file "n"
#  fileFlags(n)     : specific code (8c string) for output file "n"
#--------------------
# This example dumps EXF diagnostics as snapshot after 10 time-steps
# Note: EXF air-sea fluxes over Sea-Ice are wrong
 &DIAGNOSTICS_LIST

  fields(1:9,1) = 'SIdHbOCN','SIdHbATC','SIdHbATO ','ADVxHEFF ','ADVyHEFF',
                   'ADVxAREA','ADVyAREA','ADVxSSLT','ADVySSLT',
  fileName(1) = 'seaiceFluxSnap',
  frequency(1) = -864000.,
  timePhase(1) =  0.,
  missing_value(1) = -999.,


  fields(1:9,2) = 'SIdHbOCN','SIdHbATC','SIdHbATO ','ADVxHEFF ','ADVyHEFF',
                   'ADVxAREA','ADVyAREA','ADVxSSLT','ADVySSLT',
  fileName(2) = 'seaiceFluxAvg',
  frequency(2) = 864000.,
  missing_value(2) = -999.,

  fields(1:1,3) = 'RHOAnoma',
  fileName(3) = 'DensityAnomaly',
  frequency(3) = 864000.,
  missing_value(3) = -999.,

  fields(1:6,4) = 'oceFWflx','oceSflux','oceQnet ','oceQsw','TFLUX ','SFLUX',
  fileName(4) = 'HeatSaltFluxSnap',
  frequency(4) = -864000.,
  timePhase(4) =  0.,
  missing_value(4) = -999.,

  fields(1:6,5) = 'oceFWflx','oceSflux','oceQnet ','oceQsw','TFLUX ','SFLUX',
  fileName(5) = 'HeatSaltFluxAvg',
  frequency(5) = 864000.,
  missing_value(5) = -999.,

# 20200901- add bottom and surface stress
  fields(1:4,6) = 'botTauX','botTauY','oceTAUX ','oceTAUY',
  fileName(6) = 'BotSurfStressAvg',
  frequency(6) = 864000.,
  missing_value(6) = -999.,

  fields(1:4,7) = 'botTauX','botTauY','oceTAUX ','oceTAUY',
  fileName(7) = 'BotSurfStressSnap_PhaseShift',
  frequency(7) = -864000.,
  missing_value(7) = -999.,

  fields(1:4,8) = 'botTauX','botTauY','oceTAUX ','oceTAUY',
  fileName(8) = 'BotSurfStressSnap',
  frequency(8) = -864000.,
  timePhase(8) = 0.,
  missing_value(8) = -999.,

# 20200905- add EXF diag for heat fluxes, averaged
  fields(1:8,9) = 'EXFhs','EXFhl','EXFlwnet','EXFswnet','EXFlwdn',
                  'EXFswdn','EXFqnet','EXFempmr',
  fileName(9) = 'EXF_diag_Avg',
  frequency(9) = 864000.,
  missing_value(9) = -999.,


# 20200906- add EXF diag for heat fluxes, snapshot
  fields(1:8,10) = 'EXFhs','EXFhl','EXFlwnet','EXFswnet','EXFlwdn',
                  'EXFswdn','EXFqnet','EXFempmr',
  fileName(10) = 'EXF_diag_Snap',
  frequency(10) = -864000.,
  timePhase(10) = 0.,
  missing_value(10) = -999.,

  fields(1:8,11) = 'EXFhs','EXFhl','EXFlwnet','EXFswnet','EXFlwdn',
                  'EXFswdn','EXFqnet','EXFempmr',
  fileName(11) = 'EXF_diag_Snap_PhaseShift',
  frequency(11) = -864000.,
  missing_value(11) = -999.,


# 20210218- add sea ice area and thickness average
  fields(1:2,12) = 'SIarea','SIheff',
  fileName(12) = 'SeaIceAvg',
  frequency(12) = 864000.,
  missing_value(12) = -999.,


# 20210920- add vorticity diagnostics, average and snapshot
  fields(1:2,13) = 'momVort3', 'momHDiv',
  fileName(13) = 'VorticityAvg',
  frequency(13) = 864000.,
  missing_value(13) = -999.,


  fields(1:2,14) = 'momVort3', 'momHDiv',
  fileName(14) = 'VorticitySnap',
  frequency(14) = -864000.,
  timePhase(14) = 0.,
  missing_value(14) = -999.,


# 20220523- add diagnostics for shelfice fresh water and heat fluxes
  fields(1:2,15) = 'SHIfwFlx', 'SHIhtFlx',
  fileName(15) = 'SHIFlxAvg',
  frequency(15) = 864000.,
  missing_value(15) = -999.,



#  fields(1:4,2)  = 'SIuice  ','SIvice  ','SIheff  ',
#                   'SIarea  ',
#  fileName(2) = 'iceDiag',
#  frequency(2) =  864000.,
#  missing_value(2) = -999.,

#  fields(1:4,3)  = 'SIuice  ','SIvice  ','SIheff  ',
#                   'SIarea  ',
#   fileName(3) = 'snapshot',
#  frequency(3) = -864000.,
#  timePhase(3) =  3600.,
#  missing_value(3) = -999.,
 &

#--------------------
# Parameter for Diagnostics of per level statistics:
#--------------------
#  diagSt_mnc (logical): write stat-diags to NetCDF files (default=diag_mnc)
#  diagSt_regMaskFile : file containing the region-mask to read-in
#  nSetRegMskFile   : number of region-mask sets within the region-mask file
#  set_regMask(i)   : region-mask set-index that identifies the region "i"
#  val_regMask(i)   : region "i" identifier value in the region mask
#--for each output-stream:
#  stat_fName(n) : prefix of the output file name (max 80c long) for outp.stream n
#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
#               > 0 : write time-average output every stat_freq seconds
#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
#  stat_fields(:,n) : list of selected diagnostics fields (8.c) in outp.stream n
#                (see "available_diagnostics.log" file for the full list of diags)
#--------------------
 &DIAG_STATIS_PARMS
# stat_fields(1:5,1)  = 'SIarea  ','SIheff  ','SIhsnow ',
#                       'SIuice  ','SIvice  ',
#  stat_fName(1) = 'iceStDiag',
#   stat_freq(1) = 7200.,
#  stat_phase(1) = 1800.,
 &
