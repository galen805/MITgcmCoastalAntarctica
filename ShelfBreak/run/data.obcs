 OB_Jnorth= 396*-1,
# OB_Ieast= 288*-1,
# OB_Iwest= 288*1,

 useOrlanskiNorth = .TRUE.,
 useOrlanskiEast = .FALSE.,
 useOrlanskiWest = .FALSE.,
 useOBCSprescribe = .TRUE.,


